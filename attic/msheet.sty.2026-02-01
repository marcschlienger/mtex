\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{msheet}[2023/05/30 Package for writing lesson sheets.]

\PassOptionsToPackage{many}{tcolorbox}
\PassOptionsToPackage{svgnames, table}{xcolor}

\DeclareOption*{\PackageWarning{msheet}{Unknown ‘\CurrentOption’}}
\ProcessOptions\relax

\RequirePackage{enumitem}
\RequirePackage{etoolbox}
\RequirePackage{fontawesome}
\RequirePackage{tasks}
\RequirePackage{tcolorbox}
\RequirePackage{xcolor}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Command definitions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NewDocumentCommand{\mchapter}{m}{%
	{%
		\fontsize{20}{25}\fontfamily{phv}\fontseries{b}\selectfont
		\definecolor{rbsblue}{HTML}{009BD4}
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\hfill\textcolor{rbsblue}{#1}\hfill}
		\vskip 1.3ex
	}
}%

\NewDocumentCommand{\mtestpart}{m}{%
	{%
		\fontsize{16}{20}\fontfamily{phv}\fontseries{b}\selectfont
		\definecolor{rbsblue}{HTML}{009BD4}
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\hfill\textcolor{rbsblue}{#1}\hfill}
		\vskip 0.7ex
	}
}%

\newcounter{msection}
\NewDocumentCommand{\msection}{sO{}}{%
	\IfBooleanTF#1%
	{%
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\bfseries Aufgabe}\quad{\itshape #2}
		\vskip 0.3ex
	}{%
		\refstepcounter{msection}%
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\bfseries Aufgabe~\arabic{msection}}\quad{\itshape #2}
		\vskip 0.3ex
	}%
}%

\NewDocumentCommand{\msectionr}{sO{}}{%
	\IfBooleanTF#1%
	{%
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\bfseries Aufgabe}\quad{\itshape #2}
	}{%
		\refstepcounter{msection}%
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\bfseries Aufgabe~\arabic{msection}}\quad{\itshape #2}
	}%
}%

%\newcounter{mscore}
%\NewDocumentCommand{\mscore}{m}{%
%	{\mbox{}\marginpar{\bfseries #1~BE}}%
%	\addtocounter{mscore}{#1}%
%}
%
%\makeatletter
%\newcommand*{\textoverline}[1]{$\overline{\hbox{#1}}\m@th$}
%\makeatother
%\NewDocumentCommand{\mtotalscore}{}{%
%	\vskip 2.6ex%
%	{\mbox{}\marginpar{\bfseries \textoverline{\themscore~BE}}}%
%}%

\newlength\mscorecnt
%\setlength\mscorecnt{0pt}

\makeatletter

\newcommand{\mscore}[1]{%
	{\mbox{}\marginpar{\bfseries #1~BE}}%
	\advance\mscorecnt#1\p@
}%

\newcommand*{\textoverline}[1]{$\overline{\hbox{#1}}\m@th$}
\newcommand{\mtotalscore}{%
	\vskip 2.6ex%
	{\mbox{}\marginpar{\bfseries \textoverline{\strip@pt\mscorecnt~BE}}}%
}%

\makeatother

\NewDocumentCommand{\mwish}{}{%
	{%
		\fontsize{20}{25}\fontfamily{phv}\fontseries{b}\selectfont
		\setlength{\parindent}{0ex}
		\vskip 4.6ex
		{\hfill Viel Erfolg! \hfill}
		\vskip 0.3ex
	}
}%

%%% box definitions on top of tikz
%% 'new page' box
\newcommand{\mibnpsymbol}{\faAngleDoubleRight\faAngleDoubleRight}
\newcommand{\mibnp}{%
	\vfill\hfill
	\tikz[baseline={(a.base)}]%
		\node[%
			draw=Cyan!60!black ,
			rounded corners=0.5ex ,
			fill=Cyan!6!white ,
			inner sep=4pt
			] (a) {\small{\sffamily\mibnpsymbol\;Bitte wenden!\;\mibnpsymbol}};
	\newpage
}%

%% inline boxes
\newcommand{\mibcolor}[2][Chocolate]{%
	\tikz[baseline={(a.base)}]%
		\node[%
			draw=#1!60!black ,
			rounded corners=0.5ex ,
			fill=#1!6!white ,
			inner sep=2pt
			] (a) {#2};
}%

\newcommand{\mibred}[1]{%
	\tikz[baseline={(a.base)}]%
		\node[%
			draw=FireBrick!60!black ,
			rounded corners=0.5ex ,
			fill=FireBrick!6!white ,
			inner sep=2pt
			] (a) {#1};
}%

\newcommand{\mibgreen}[1]{%
	\tikz[baseline={(a.base)}]%
		\node[%
			draw=LightGreen!60!black ,
			rounded corners=0.5ex ,
			fill=LightGreen!6!white ,
			inner sep=2pt
			] (a) {#1};
}%

\newcommand{\mibblue}[1]{%
	\tikz[baseline={(a.base)}]%
		\node[%
			draw=DodgerBlue!60!black ,
			rounded corners=0.5ex ,
			fill=DodgerBlue!6!white ,
			inner sep=2pt
			] (a) {#1};
}%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Environment definitions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newenvironment{menumerate}%
	{\begin{enumerate}%
		\renewcommand*{\theenumi}{\alph{enumi}}
		\renewcommand*{\theenumii}{\arabic{enumii}}
		\renewcommand*{\theenumiii}{\Alph{enumiii}}
		\renewcommand*{\theenumiv}{\Roman{enumiv}}
		\renewcommand*{\labelenumi}{\textbf{\theenumi)}}
		\renewcommand*{\labelenumii}{(\theenumii)}
		\renewcommand*{\labelenumiii}{\theenumiii.}
		\renewcommand*{\labelenumiv}{\theenumiv}
		%\setlength{\leftmargini}{2.0em}
		%\setlength{\leftmarginii}{1.76em}
		%\setlength{\leftmarginiii}{1.50em}
		%\setlength{\leftmarginiv}{1.28em}
	}%
{\end{enumerate}}%
%\setlist*[enumerate, 1]{wide=0pt, labelwidth=0.5cm, leftmargin=!}
%\setlist*[enumerate, 2]{align=left, labelwidth=0.5cm, leftmargin=0cm}%

\newenvironment{menumeratex}%
	{\begin{enumerate}%
		\renewcommand*{\theenumi}{\thesection.\arabic{enumi}}
		\renewcommand*{\theenumii}{\theenumi.\arabic{enumii}}
		\renewcommand*{\theenumiii}{\theenumii.\arabic{enumiii}}
		\renewcommand*{\theenumiv}{\theenumiii.\arabic{enumiv}}
		\renewcommand*{\labelenumi}{\theenumi.}
		\renewcommand*{\labelenumii}{\theenumii.}
		\renewcommand*{\labelenumiii}{\theenumiii.}
		\renewcommand*{\labelenumiv}{\theenumiv.}
		\renewcommand*{\p@enumi}{}
		\renewcommand*{\p@enumii}{}
		\renewcommand*{\p@enumiii}{}
		\renewcommand*{\p@enumiv}{}
		\setlength{\leftmargini}{2.5em}
		\setlength{\leftmarginii}{2.2em}
		\setlength{\leftmarginiii}{1.87em}
		\setlength{\leftmarginiv}{1.6em}
	}%
{\end{enumerate}}%

%%% box definitions on top of tcolorbox
%% boxes with title
\newtcolorbox{mtbcolor}[2][Chocolate]{%
	size=fbox,
	fonttitle=\large\sffamily\bfseries,
	fontupper=\normalsize\sffamily\mdseries,
	colback=#1!6!white,
	colframe=#1!24!black,
	colbacktitle=#1!50!white,
	coltitle=#1!12!black,
	title={#2}
}%

\newtcolorbox{mtbred}[1][Merksatz]{%
	size=fbox,
	fonttitle=\large\sffamily\bfseries,
	fontupper=\normalsize\sffamily\mdseries,
	colback=Yellow!6!white,
	colframe=FireBrick!24!black,
	colbacktitle=FireBrick!70!white,
	coltitle=FireBrick!12!black,
	title={#1}
}%

\newtcolorbox{mtbgreen}[1][Versuch]{%
	fonttitle=\large\sffamily\bfseries,
	fontupper=\normalsize\sffamily\mdseries,
	size=fbox,
	colback=Yellow!6!white,
	colframe=LightGreen!24!black,
	colbacktitle=LightGreen!80!white,
	coltitle=LightGreen!12!black,
	title={#1}
}%

\newtcolorbox{mtbblue}[1][Beispiel]{%
	size=fbox,
	fonttitle=\large\sffamily\bfseries,
	fontupper=\normalsize\sffamily\mdseries,
	colback=Yellow!6!white,
	colframe=DodgerBlue!24!black,
	colbacktitle=DodgerBlue!50!white,
	coltitle=DodgerBlue!12!black,
	title={#1}
}%

%% boxes without title
\newtcolorbox{mbcolor}[1][Chocolate]{%
	size=fbox,
	colback=#1!6!white,
	colframe=#1!24!black,
}%

\newtcolorbox{mbred}{%
	size=fbox,
	fontupper=\normalsize\sffamily\mdseries,
	colback=FireBrick!12!white,
	colframe=FireBrick!48!black,
}%

\newtcolorbox{mbgreen}{%
	size=fbox,
	fontupper=\normalsize\sffamily\mdseries,
	colback=LightGreen!24!white,
	colframe=LightGreen!24!black,
}%

\newtcolorbox{mbblue}{%
	size=fbox,
	fontupper=\normalsize\sffamily\mdseries,
	colback=Yellow!6!white,
	colframe=DodgerBlue!24!black,
}%

\newtcolorbox{mbinfo}{%
	size=fbox,
	colback=LightSeaGreen!12!white,
	colframe=LightSeaGreen!24!black,
}%

%%% list definitions on top of the enumitem package
\newlist{mtasklist}{enumerate}{4}
\setlist*[mtasklist, 1]{%
	label*=\textbf{\arabic*.},
	wide=0pt,
	labelwidth=1.5cm,
	leftmargin=!,
}%
\setlist*[mtasklist, 2]{
	label*=\textbf{\arabic*.},
	align=left,
	labelwidth=1.5cm,
	leftmargin=0cm,
}%
\setlist*[mtasklist, 3]{%
	label*=\textbf{\arabic*.},
	align=left,
	labelwidth=1.5cm,
	leftmargin=0cm,
}%
\setlist*[mtasklist, 4]{
	label*=\textbf{\arabic*.},
	align=left,
	labelwidth=1.5cm,
	leftmargin=0cm,
}%

\newlist{msectioniselist}{enumerate}{4}
\setlist*[msectioniselist, 1]{%
	label=\textbf{Aufgabe~\arabic*},
	wide=0pt,
	labelwidth=0.5cm,
	labelsep=0.35cm,
	leftmargin=!,
}%
\setlist*[msectioniselist, 2]{%
	label=\textbf{\alph*},
  align=left,
	labelwidth=0.5cm,
	leftmargin=0cm,
}%
\setlist*[msectioniselist, 3]{%
	label=\textbf{\roman*.},
	align=left,
	labelwidth=0.5cm,
	leftmargin=0cm,
}%
\setlist*[msectioniselist, 4]{%
	label=\textbf{\Alph*.},
	align=left,
	labelwidth=0.5cm,
	leftmargin=0cm,
}%

%%% list definitions on top of the tasks package
\NewTasksEnvironment[%
	label=\textbf{\alph*)},
	item-indent=2em,
	label-width=2em,
	label-offset=0pt,
	]{mexccolumns}[\exc]

\NewTasksEnvironment[%
	label=\textbf{\arabic*.},
	item-indent=2em,
	label-width=2em,
	label-offset=0pt,
]{mtaskcolumns}[\task]
