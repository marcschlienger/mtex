%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Palette
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% One place to restyle everything.  The boxes below refer to these names
%% only, so "Merksätze should be blue from now on" is a one-line change.
\definecolor{rbsblue}{HTML}{009BD4}

\colorlet{msheet@rule}{FireBrick}        % Merksatz, Satz, Regel
\colorlet{msheet@experiment}{LightGreen} % Versuch, Vorgehen
\colorlet{msheet@example}{DodgerBlue}    % Beispiel, Definition
\colorlet{msheet@info}{LightSeaGreen}    % Information, Hinweis
\colorlet{msheet@frame}{Chocolate}       % free title, neutral frame
\colorlet{msheet@tag}{LightGreen}        % inline Tipp / Lösung markers
\colorlet{msheet@turn}{Cyan}             % "Bitte wenden!"

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Headings
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NewDocumentCommand{\mchapter}{m}{%
	{%
		\fontsize{20}{25}\fontfamily{phv}\fontseries{b}\selectfont
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\hfill\textcolor{rbsblue}{#1}\hfill}
		\vskip 1.3ex
	}
}%

\NewDocumentCommand{\mtestpart}{m}{%
	{%
		\fontsize{16}{20}\fontfamily{phv}\fontseries{b}\selectfont
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\hfill\textcolor{rbsblue}{#1}\hfill}
		\vskip 0.7ex
	}
}%

%% \msection -- an exercise heading that behaves like a subsection.
%% \msectionr -- the same, run in: the text continues on the heading line.
%% The starred forms omit the number.
\newcounter{msection}
\NewDocumentCommand{\msection}{sO{}}{%
	\IfBooleanTF#1%
	{%
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\bfseries Aufgabe}\quad{\itshape #2}
		\vskip 0.3ex
	}{%
		\refstepcounter{msection}%
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\bfseries Aufgabe~\arabic{msection}}\quad{\itshape #2}
		\vskip 0.3ex
	}%
}%

\NewDocumentCommand{\msectionr}{sO{}}{%
	\IfBooleanTF#1%
	{%
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\bfseries Aufgabe}\quad{\itshape #2}
	}{%
		\refstepcounter{msection}%
		\setlength{\parindent}{0ex}
		\vskip 2.3ex
		{\bfseries Aufgabe~\arabic{msection}}\quad{\itshape #2}
	}%
}%

\NewDocumentCommand{\mwish}{}{%
	{%
		\fontsize{20}{25}\fontfamily{phv}\fontseries{b}\selectfont
		\setlength{\parindent}{0ex}
		\vskip 4.6ex
		{\hfill Viel Erfolg! \hfill}
		\vskip 0.3ex
	}
}%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Scores
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \mscore puts the score of the current exercise into the margin and adds
%% it to a running total, \mtotalscore prints the total (underlined),
%% \mresetscore starts a new count.  The count lives in a dimen so that half
%% points work; the assignment is global so that \mscore also works inside
%% boxes, lists and environments.  marginnote (rather than \marginpar) for
%% the same reason -- note that it needs a second LaTeX run.
\newlength\mscorecnt

\newcommand{\mscore}[1]{%
	\marginnote{\bfseries #1~BE}%
	\global\advance\mscorecnt#1\p@
}%

\newcommand{\mresetscore}{\global\mscorecnt\z@}%

\newcommand*{\textoverline}[1]{$\overline{\hbox{#1}}\m@th$}
\newcommand{\mtotalscore}{%
	\vskip 2.6ex%
	\marginnote{\bfseries
		\textoverline{\fpeval{\strip@pt\mscorecnt}~BE}}%
}%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Inline markers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \mtag{...} is the inline pill used for hints in the running text;
%% \mtip and \msolution are the two uses it actually has.
\newcommand{\mtag}[2][msheet@tag]{%
	\tikz[baseline={(a.base)}]%
		\node[%
			draw=#1!60!black ,
			rounded corners=0.5ex ,
			fill=#1!6!white ,
			inner sep=2pt
			] (a) {#2};
}%
\newcommand{\mtip}[1][]{\mtag{Tipp~#1}}%
\newcommand{\msolution}[1][]{\mtag{L\"osung~#1}}%

%% "Bitte wenden!" at the foot of the page, then a page break.
\newcommand{\mturnsymbol}{\faAngleDoubleRight\faAngleDoubleRight}
%% \vspace*, not \vfill: TeX discards vertical glue at the top of a page,
%% so a plain \vfill silently evaporates whenever \mibnp lands on a freshly
%% broken page -- and the marker jumps from the bottom to the top.
\newcommand{\mibnp}{%
	\vspace*{\fill}\hfill
	\tikz[baseline={(a.base)}]%
		\node[%
			draw=msheet@turn!60!black ,
			rounded corners=0.5ex ,
			fill=msheet@turn!6!white ,
			inner sep=4pt
			] (a) {\small{\sffamily\mturnsymbol\;Bitte wenden!\;\mturnsymbol}};
	\newpage
}%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Boxes
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Named after what goes in them.  Each has a starred form without a title,
%% as in amsthm.  The optional argument overrides the default title.
%%
%%   mrule       Merksatz, Satz, Regel
%%   mexperiment Versuch, Vorgehen
%%   mexample    Beispiel, Definition
%%   minfo       Information, Hinweis
%%   mframe      free title, neutral frame; [colour] to recolour
%%
%% NB: the starred (untitled) forms keep the exact colours and font
%% settings of the boxes they replace, which are not always those of the
%% titled form -- mframe* and minfo* deliberately do not set fontupper, so
%% their body stays in the document font.
\tcbset{
	msheet@titled/.style={
		size=fbox,
		fonttitle=\large\sffamily\bfseries,
		fontupper=\normalsize\sffamily\mdseries,
	},
	msheet@plain/.style={
		size=fbox,
		fontupper=\normalsize\sffamily\mdseries,
	},
}

%% Merksatz, Satz, Regel
\newtcolorbox{mrule}[1][Merksatz]{%
	msheet@titled,
	colback=Yellow!6!white,
	colframe=msheet@rule!24!black,
	colbacktitle=msheet@rule!70!white,
	coltitle=msheet@rule!12!black,
	title={#1}
}%
\newtcolorbox{mrule*}{%
	msheet@plain,
	colback=msheet@rule!12!white,
	colframe=msheet@rule!48!black,
}%

%% Versuch, Vorgehen
\newtcolorbox{mexperiment}[1][Versuch]{%
	msheet@titled,
	colback=Yellow!6!white,
	colframe=msheet@experiment!24!black,
	colbacktitle=msheet@experiment!80!white,
	coltitle=msheet@experiment!12!black,
	title={#1}
}%
\newtcolorbox{mexperiment*}{%
	msheet@plain,
	colback=msheet@experiment!24!white,
	colframe=msheet@experiment!24!black,
}%

%% Beispiel, Definition
\newtcolorbox{mexample}[1][Beispiel]{%
	msheet@titled,
	colback=Yellow!6!white,
	colframe=msheet@example!24!black,
	colbacktitle=msheet@example!50!white,
	coltitle=msheet@example!12!black,
	title={#1}
}%
\newtcolorbox{mexample*}{%
	msheet@plain,
	colback=Yellow!6!white,
	colframe=msheet@example!24!black,
}%

%% Information, Hinweis.  The titled form is new; the starred one is the
%% former mbinfo and keeps its document-font body.
\newtcolorbox{minfo}[1][Information]{%
	msheet@titled,
	colback=msheet@info!12!white,
	colframe=msheet@info!24!black,
	colbacktitle=msheet@info!50!white,
	coltitle=msheet@info!12!black,
	title={#1}
}%
\newtcolorbox{minfo*}{%
	size=fbox,
	colback=msheet@info!12!white,
	colframe=msheet@info!24!black,
}%

%% Free title, neutral frame; the optional argument recolours the box.
\newtcolorbox{mframe}[2][msheet@frame]{%
	msheet@titled,
	colback=#1!6!white,
	colframe=#1!24!black,
	colbacktitle=#1!50!white,
	coltitle=#1!12!black,
	title={#2}
}%
\newtcolorbox{mframe*}[1][msheet@frame]{%
	size=fbox,
	colback=#1!6!white,
	colframe=#1!24!black,
}%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Lists
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% menumerate  -- the everyday enumeration: a), (1), A., I
%% mexccolumns -- n columns of short sub-exercises, separated by \exc
\newenvironment{menumerate}%
	{\begin{enumerate}%
		\renewcommand*{\theenumi}{\alph{enumi}}
		\renewcommand*{\theenumii}{\arabic{enumii}}
		\renewcommand*{\theenumiii}{\Alph{enumiii}}
		\renewcommand*{\theenumiv}{\Roman{enumiv}}
		\renewcommand*{\labelenumi}{\textbf{\theenumi)}}
		\renewcommand*{\labelenumii}{(\theenumii)}
		\renewcommand*{\labelenumiii}{\theenumiii.}
		\renewcommand*{\labelenumiv}{\theenumiv}
	}%
{\end{enumerate}}%

\NewTasksEnvironment[%
	label=\textbf{\alph*)},
	item-indent=2em,
	label-width=2em,
	label-offset=0pt,
	]{mexccolumns}[\exc]
